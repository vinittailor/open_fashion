# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_fashion_db?schema=public"

# Redis Connection URL
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets (Replace with secure random strings in local .env)
JWT_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multi-client access)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
